{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "gentoo",
        "position": "left",
        "height": 16,
        "color": {
            "1": "light_red",
            "2": "light_magenta"
        },
        "padding": {
            "top": 0,
            "right": 3
        }
    },
    "display": {
        "separator": "  🎀  "
    },
    "modules": [
        {
            "type": "custom",
            "key": "╭─── 🎀 [ sayori.chr ] ───────────────────────────────────╮",
            "keyColor": "light_red"
        },
        "break",
        {
            "type": "custom",
            "key": "Club Role      ",
            "keyColor": "light_magenta",
            "format": "Vice President (Act 1) / President (Act 4)"
        },
        {
            "type": "custom",
            "key": "Personality    ",
            "keyColor": "light_magenta",
            "format": "Clumsy, Cheerful... and Sad"
        },
        "break",
        {
            "type": "custom",
            "key": "Poem Style     ",
            "keyColor": "light_red",
            "format": "Bittersweet, Simple words, Deep meaning"
        },
        {
            "type": "custom",
            "key": "Favorite Thing ",
            "keyColor": "light_red",
            "format": "Making everyone happy, Snacks"
        },
        {
            "type": "custom",
            "key": "Current Thought",
            "keyColor": "light_red",
            "format": "\"Get out of my head. Get out of my head.\""
        },
        "break",
        {
            "type": "custom",
            "key": "Rainclouds     ",
            "keyColor": "light_magenta",
            "format": "They won't go away."
        },
        {
            "type": "custom",
            "key": "File Condition ",
            "keyColor": "light_magenta",
            "format": "Restored / Corrupted"
        },
        "break",
        {
            "type": "custom",
            "key": "├─── 🌸 [ Poem Words ] ───────────────────────────────────┤",
            "keyColor": "light_red"
        },
        "break",
        {
            "type": "custom",
            "format": "Alone  Broken  Depression  Empty  Hopeless  Hurt  Raincloud"
        },
        "break",
        {
            "type": "custom",
            "key": "╰─────────────────────────────────────────────────────────╯",
            "keyColor": "light_red"
        }
    ]
}
